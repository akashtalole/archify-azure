{
  "diagram_type": "sequence",
  "meta": { "title": "Agent tool call with content safety and approval", "subtitle": "A user question reaches a Foundry agent; the model proposes a tool call; content safety screens it; a high-impact call waits for approval", "lens": ["framework", "generative-ai"], "output": "examples/out/agent-tool-call.html", "cost": { "note": "Cost tab covers the participants only; the sequence has no volumes." } },
  "participants": [
    { "id": "user", "icon": "users", "label": "User" },
    { "id": "apim", "icon": "apim", "label": "API Management", "sublabel": "auth, throttling" },
    { "id": "agent", "icon": "foundry-agent-service", "label": "Foundry Agent Service" },
    { "id": "safety", "icon": "content-safety", "label": "AI Content Safety" },
    { "id": "fm", "icon": "openai", "label": "Azure OpenAI", "usage": { "model": "gpt-4o-0806", "inputTokensPerMonth": 20000000, "outputTokensPerMonth": 2000000 } },
    { "id": "tool", "icon": "function-apps", "label": "Azure Functions", "sublabel": "tool: update record" },
    { "id": "mon", "icon": "log-analytics-workspaces", "label": "Log Analytics" }
  ],
  "groups": [ { "kind": "azure-cloud", "label": "Azure", "members": ["apim", "agent", "safety", "fm", "tool", "mon"] } ],
  "messages": [
    { "from": "user", "to": "apim", "label": "ask a question", "desc": "The request carries an Entra ID token." },
    { "from": "apim", "to": "agent", "label": "validated request" },
    { "from": "agent", "to": "safety", "label": "screen prompt" },
    { "from": "safety", "to": "agent", "kind": "return", "label": "allowed" },
    { "from": "agent", "to": "fm", "label": "reason + choose tool" },
    { "from": "fm", "to": "agent", "kind": "return", "label": "tool call proposal" },
    { "from": "agent", "to": "safety", "label": "screen tool arguments" },
    { "note": "High-impact calls wait for human approval before they run.", "over": ["agent", "tool"] },
    { "from": "agent", "to": "tool", "label": "invoke tool (managed identity)" },
    { "from": "tool", "to": "agent", "kind": "return", "label": "result" },
    { "from": "agent", "to": "mon", "kind": "async", "label": "trace + token usage" },
    { "from": "agent", "to": "apim", "kind": "return", "label": "answer" },
    { "from": "apim", "to": "user", "kind": "return", "label": "response" }
  ],
  "fragments": [ { "kind": "opt", "label": "tool needed", "from": 6, "to": 9 } ]
}
