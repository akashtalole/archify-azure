  "edges": [
    {
      "from": "customers",
      "to": "cs_cust",
      "step": 1,
      "label": "chat",
      "desc": "A customer reports a claim or asks about coverage in the web chat or Teams; Copilot Studio authenticates them with Entra ID"
    },
    {
      "from": "cs_cust",
      "to": "flow_in",
      "step": 2,
      "label": "documents",
      "desc": "Uploaded photos and forms trigger the document intake flow, which extracts fields and creates the case in Dataverse"
    },
    {
      "from": "flow_in",
      "to": "dv",
      "step": 3,
      "label": "create case"
    },
    {
      "from": "cs_cust",
      "to": "apim",
      "step": 4,
      "label": "agent handoff",
      "desc": "Coverage and status questions are handed to the Foundry orchestrator through the API Management AI gateway, with the user's token"
    },
